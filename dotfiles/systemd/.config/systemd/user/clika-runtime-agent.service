[Unit]
Description=Clika Device Agent
After=network-online.target
Wants=network-online.target
# A crash loop is bounded: more than 10 starts within 10 minutes stops the
# unit until an operator restarts it (a healthy agent starts once).
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/home/raybeak/.local/bin/clika-runtime-agent daemon --config /home/raybeak/.clika-runtime-agent/config.yaml
Restart=always
RestartSec=5
# The agent's deliberate refusals are not crashes and are not restarted: an
# enrollment the platform will never accept, or a device an operator deleted
# on the platform, which stays stopped until the agent is reinstalled (exit
# 3); a state directory another agent instance holds (exit 4); a config file
# the agent cannot run with, which an operator edits (exit 5). Retrying
# cannot change any of these answers.
RestartPreventExitStatus=3 4 5
LimitNOFILE=65535

[Install]
WantedBy=default.target
