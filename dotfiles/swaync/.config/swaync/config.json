{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-width": 420,
  "notification-window-width": 380,
  "notification-icon-size": 0,
  "notification-body-image-height": 0,
  "notification-body-image-width": 0,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "hide-on-clear": true,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "[NOTIFICATIONS]",
      "clear-all-button": true,
      "button-text": "[CLEAR]"
    },
    "dnd": {
      "text": "DND"
    }
  }
}
