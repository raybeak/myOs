#!/usr/bin/env bash
# myos-webapp — Manage and launch frameless Brave web apps (.desktop shortcuts).
# Usage:
#   myos-webapp add <name> <url>
#   myos-webapp remove <name>
#   myos-webapp list
#   myos-webapp launch <name|url>
set -euo pipefail

APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
PREFIX="myos-webapp-"
BROWSER="${MYOS_WEBAPP_BROWSER:-brave-browser}"

validate_browser() {
  local bin="$1"
  local bin_re='^[A-Za-z0-9._/-]+$'
  if [[ ! "$bin" =~ $bin_re ]]; then
    echo "Error: invalid MYOS_WEBAPP_BROWSER '$bin' (must be a single executable name/path)." >&2
    exit 2
  fi
  if ! command -v "$bin" >/dev/null 2>&1; then
    echo "Error: browser '$bin' not found in PATH." >&2
    exit 127
  fi
}

validate_name() {
  local name="$1"
  local name_re='^[A-Za-z0-9_-]{1,40}$'
  if [[ ! "$name" =~ $name_re ]]; then
    echo "Error: invalid app name '$name' (allowed: A-Z, a-z, 0-9, _, -, max 40 chars)." >&2
    exit 2
  fi
}

validate_url() {
  local url="$1"
  local url_re='^https?://[]A-Za-z0-9._~:/?#@!()+%=&[-]+$'
  if [[ ! "$url" =~ $url_re ]]; then
    echo "Error: invalid URL '$url' (must start with http:// or https:// without whitespace or unsafe desktop-entry characters)." >&2
    exit 2
  fi
}

escape_desktop_exec() {
  # Escape '%' -> '%%' per Desktop Entry Specification so %f/%u/%20 are not expanded as field codes.
  printf '%s' "${1//%/%%}"
}

unescape_desktop_exec() {
  printf '%s' "${1//%%/%}"
}

extract_url_from_desktop() {
  local raw
  raw="$(sed -n 's/^Exec=[^ ]* --app=//p' "$1" | head -n1)"
  unescape_desktop_exec "$raw"
}

desktop_path() {
  printf '%s/%s%s.desktop' "$APP_DIR" "$PREFIX" "$1"
}

cmd_add() {
  [[ $# -eq 2 ]] || { echo "Usage: myos-webapp add <name> <url>" >&2; exit 2; }
  local name="$1"
  local url="$2"
  validate_browser "$BROWSER"
  validate_name "$name"
  validate_url "$url"

  mkdir -p "$APP_DIR"
  local target esc_url
  target="$(desktop_path "$name")"
  esc_url="$(escape_desktop_exec "$url")"

  cat >"$target" <<EOF
[Desktop Entry]
Type=Application
Name=WebApp: ${name}
Comment=myOs frameless web app
Exec=${BROWSER} --app=${esc_url}
Terminal=false
Categories=Network;WebBrowser;
EOF
  chmod 644 "$target"
  echo "Added web app: $name -> $target"
}

cmd_remove() {
  [[ $# -eq 1 ]] || { echo "Usage: myos-webapp remove <name>" >&2; exit 2; }
  local name="$1"
  validate_name "$name"
  local target
  target="$(desktop_path "$name")"
  if [[ -f "$target" ]]; then
    rm -f "$target"
    echo "Removed web app: $name"
  else
    echo "Error: web app '$name' not found." >&2
    exit 1
  fi
}

cmd_list() {
  shopt -s nullglob
  local files=("$APP_DIR/${PREFIX}"*.desktop)
  if ((${#files[@]} == 0)); then
    exit 0
  fi
  local f base name url
  for f in "${files[@]}"; do
    base="$(basename "$f" .desktop)"
    name="${base#"$PREFIX"}"
    url="$(extract_url_from_desktop "$f")"
    printf '%s\t%s\n' "$name" "$url"
  done
}

cmd_launch() {
  [[ $# -eq 1 ]] || { echo "Usage: myos-webapp launch <name|url>" >&2; exit 2; }
  validate_browser "$BROWSER"
  local arg="$1"
  local url=""
  if [[ "$arg" =~ ^https?:// ]]; then
    validate_url "$arg"
    url="$arg"
  else
    validate_name "$arg"
    local target
    target="$(desktop_path "$arg")"
    if [[ ! -f "$target" ]]; then
      echo "Error: web app '$arg' not found." >&2
      exit 1
    fi
    url="$(extract_url_from_desktop "$target")"
    validate_url "$url"
  fi
  nohup "$BROWSER" --app="$url" >/dev/null 2>&1 &
}

case "${1:-}" in
  add)    shift; cmd_add "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  list)   shift; cmd_list ;;
  launch) shift; cmd_launch "$@" ;;
  -h|--help|"")
    cat <<'EOF'
Usage:
  myos-webapp add <name> <url>
  myos-webapp remove <name>
  myos-webapp list
  myos-webapp launch <name|url>
EOF
    ;;
  *)
    echo "Error: unknown subcommand '$1'." >&2
    exit 2
    ;;
esac
