#!/usr/bin/env bash
# myos-brightness — Seat-scoped backlight control via systemd-logind D-Bus (no video group required).
# Usage:
#   myos-brightness up [step_pct]      (default step: 5%)
#   myos-brightness down [step_pct]    (default step: 5%, clamped to MYOS_BACKLIGHT_MIN_PCT=2%)
#   myos-brightness set <pct>          (integer 2..100, clamped to min floor)
#   myos-brightness get                (prints current percentage)
# Env: MYOS_BACKLIGHT_DEV (default: intel_backlight), MYOS_BACKLIGHT_MIN_PCT (default: 2)
set -euo pipefail

ACTION="${1:-get}"
DEVICE="${MYOS_BACKLIGHT_DEV:-intel_backlight}"
MIN_PCT="${MYOS_BACKLIGHT_MIN_PCT:-2}"

dev_re='^[A-Za-z0-9._-]+$'
if [[ ! "$DEVICE" =~ $dev_re ]]; then
  echo "Error: invalid MYOS_BACKLIGHT_DEV '$DEVICE'." >&2
  exit 2
fi
if [[ ! "$MIN_PCT" =~ ^[0-9]+$ ]] || ((MIN_PCT < 1 || MIN_PCT > 50)); then
  echo "Error: MYOS_BACKLIGHT_MIN_PCT must be an integer 1..50 (got '$MIN_PCT')." >&2
  exit 2
fi

SYS_DIR="/sys/class/backlight/${DEVICE}"
if [[ ! -r "${SYS_DIR}/brightness" || ! -r "${SYS_DIR}/max_brightness" ]]; then
  echo "Error: backlight device '$DEVICE' not readable under /sys/class/backlight." >&2
  exit 1
fi

CUR="$(<"${SYS_DIR}/brightness")"
MAX="$(<"${SYS_DIR}/max_brightness")"
if [[ ! "$CUR" =~ ^[0-9]+$ || ! "$MAX" =~ ^[1-9][0-9]*$ ]]; then
  echo "Error: invalid sysfs brightness values (cur='$CUR', max='$MAX')." >&2
  exit 1
fi

MIN_VAL=$(((MAX * MIN_PCT + 99) / 100))
((MIN_VAL < 1)) && MIN_VAL=1

set_brightness() {
  local target="$1"
  ((target < MIN_VAL)) && target="$MIN_VAL"
  ((target > MAX)) && target="$MAX"

  if busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness ssu backlight "$DEVICE" "$target" >/dev/null 2>&1; then
    return 0
  fi

  local sid
  sid="$(loginctl list-sessions --no-legend 2>/dev/null \
    | awk -v u="$(id -un)" '$3 == u && $4 != "-" && $4 != "" {print $1; exit}')"
  if [[ -n "$sid" ]]; then
    busctl call org.freedesktop.login1 "/org/freedesktop/login1/session/${sid}" \
      org.freedesktop.login1.Session SetBrightness ssu backlight "$DEVICE" "$target" >/dev/null
    return 0
  fi

  echo "Error: unable to set brightness via systemd-logind (no active seated session)." >&2
  exit 1
}

case "$ACTION" in
  get)
    echo "$(((CUR * 100 + MAX / 2) / MAX))%"
    ;;
  up|down)
    STEP="${2:-5}"
    if [[ ! "$STEP" =~ ^[1-9][0-9]*$ ]] || ((STEP > 100)); then
      echo "Error: step must be an integer 1..100 (got '$STEP')." >&2
      exit 2
    fi
    CUR_PCT=$(((CUR * 100 + MAX / 2) / MAX))
    if [[ "$ACTION" == "up" ]]; then
      NEXT_PCT=$((((CUR_PCT / STEP) + 1) * STEP))
    else
      if ((CUR_PCT <= STEP)); then
        NEXT_PCT="$MIN_PCT"
      else
        NEXT_PCT=$((((CUR_PCT - 1) / STEP) * STEP))
      fi
    fi
    ((NEXT_PCT > 100)) && NEXT_PCT=100
    ((NEXT_PCT < MIN_PCT)) && NEXT_PCT="$MIN_PCT"
    set_brightness $(((MAX * NEXT_PCT + 50) / 100))
    ;;
  set)
    PCT="${2:-}"
    if [[ ! "$PCT" =~ ^[0-9]{1,3}$ ]] || ((PCT > 100)); then
      echo "Error: percentage must be an integer 0..100 (got '$PCT')." >&2
      exit 2
    fi
    set_brightness $(((MAX * PCT + 50) / 100))
    ;;
  -h|--help)
    echo "Usage: myos-brightness [up [pct]|down [pct]|set <pct>|get]"
    ;;
  *)
    echo "Error: unknown action '$ACTION'." >&2
    exit 2
    ;;
esac
